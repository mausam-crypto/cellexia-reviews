{% comment %}
  cx-i18n — emits every `cellexia.*` storefront string from the extension locale files
  as a flat JSON dictionary for the widget JS (assets/cellexia-reviews.js).

  Mechanism (SPEC §8): every interpolation variable is passed the literal sentinel
  `[[var]]` so the translated string reaches JS with its placeholders intact — the JS
  `t(key, vars)` helper substitutes them. Locale values that already contain literal
  [[var]] sentinels pass through the `t` filter unchanged.

  Pluralized keys (widget.global_ratings, widget.star_row, widget.review_count,
  review.helpful_count, form.rating_value) emit one entry per plural form present in
  the active locale file: "key.one", "key.other", plus zero/two/few/many where the
  language defines them (pl/ro/ar…). JS picks the form via Intl.PluralRules.

  Keys are relative to the `cellexia.` namespace (e.g. "widget.title").
  Keep this snippet mechanically in sync with locales/en.default.json.
{% endcomment %}
<script type="application/json" id="cx-i18n">
{
{%- assign cx_i18n_plural_keys = 'widget.global_ratings|widget.star_row|widget.review_count|review.helpful_count|form.rating_value' | split: '|' -%}
{%- assign cx_i18n_plural_forms = 'zero|one|two|few|many|other' | split: '|' -%}
{%- for cx_i18n_pk in cx_i18n_plural_keys -%}
{%- for cx_i18n_pf in cx_i18n_plural_forms -%}
{%- capture cx_i18n_key -%}cellexia.{{ cx_i18n_pk }}.{{ cx_i18n_pf }}{%- endcapture -%}
{%- assign cx_i18n_val = cx_i18n_key | t: count: '[[count]]' -%}
{%- unless cx_i18n_val contains 'Translation missing' %}
  "{{ cx_i18n_pk }}.{{ cx_i18n_pf }}": {{ cx_i18n_val | json }},
{%- endunless -%}
{%- endfor -%}
{%- endfor %}
  "widget.title": {{ 'cellexia.widget.title' | t | json }},
