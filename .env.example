# ─── Shopify app credentials ─────────────────────────────────────────────────
# Client ID / client secret of the app created in your Partner Dashboard.
# During `npm run dev` the Shopify CLI injects these automatically; set them
# explicitly on your production host. SHOPIFY_API_SECRET is also the key used
# to verify app-proxy signatures on the storefront JSON API.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of the deployed app backend (no trailing slash).
SHOPIFY_APP_URL=https://your-app-host.example.com

# OAuth scopes — must match [access_scopes] in shopify.app.toml.
SCOPES=read_orders,read_products,write_products,read_files,write_files,read_markets,write_content

# ─── Database ────────────────────────────────────────────────────────────────
# The default prisma/schema.prisma uses SQLite at prisma/dev.sqlite and does
# NOT read this variable. To switch to Postgres/MySQL, change the datasource in
# prisma/schema.prisma to `url = env("DATABASE_URL")` (a one-line change,
# see docs/INSTALL.md) and set:
# DATABASE_URL=postgresql://user:password@host:5432/cellexia_reviews

# ─── Optional ────────────────────────────────────────────────────────────────
# Name of a platform-guaranteed client-IP header for rate-limit buckets, e.g.
# fly-client-ip (Fly.io), true-client-ip (Render), cf-connecting-ip (Cloudflare).
# Leave unset unless your platform reliably sets one.
# CELLEXIA_CLIENT_IP_HEADER=

# ─── Development only ────────────────────────────────────────────────────────
# Accept app-proxy requests without a valid Shopify signature. Local dev and
# demo use only — NEVER set this in production.
# CELLEXIA_ALLOW_UNSIGNED=1
