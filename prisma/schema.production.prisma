generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Review {
  id           String        @id @default(cuid())
  shop         String
  productId    String        // numeric Shopify product id as string, e.g. "8654321098765"
  productTitle String?
  productHandle String?
  rating       Int           // 1..5
  title        String?
  body         String
  language     String        @default("en") // ISO 639-1 (+region for pt-PT)
  authorName   String
  authorEmail  String?
  customerId   String?
  country      String?       // ISO 3166-1 alpha-2, optional
  variantTitle String?
  verified     Boolean       @default(false)
  status       String        @default("PENDING") // PENDING | PUBLISHED | REJECTED | SPAM
  ageRange     String?       // AGE_RANGES key
  skinConcerns String        @default("[]") // JSON array of SKIN_CONCERNS keys
  timeUsing    String?       // TIME_USING key
  resultsSeen  String        @default("[]") // JSON array of RESULTS_SEEN keys
  helpfulCount Int           @default(0)
  reportCount  Int           @default(0)
  reply        String?
  replyAt      DateTime?
  ipHash       String?
  isSynthetic  Boolean       @default(false) // v1.4 QA generator flag — admin-only, never serialized to the storefront
  qaChecked    Boolean       @default(false) // v1.24: this synthetic row survived (or predates) the skeptic pass
  source       String?       // "storefront" | "csv-import" | "bulk-add" | "synthetic" (null = pre-1.4 rows)
  syntheticBatchId     String?   // groups one QA-generator run; null for non-synthetic rows
  syntheticGeneratedAt DateTime? // when the QA generator created the row (createdAt holds the backdated review date)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  media        ReviewMedia[]
  votes        Vote[]

  @@index([shop, productId, status])
  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([shop, isSynthetic])
}

model ReviewMedia {
  id        String  @id @default(cuid())
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  type      String  // IMAGE | VIDEO
  fileGid   String? // Shopify File GID
  url       String? // resolved CDN URL (nullable until Shopify finishes processing)
  thumbUrl  String?
  position  Int     @default(0)

  @@index([reviewId])
}

model Vote {
  id           String   @id @default(cuid())
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId     String
  visitorToken String
  type         String   // HELPFUL | REPORT
  reason       String?  // REPORT_REASONS key
  createdAt    DateTime @default(now())

  @@unique([reviewId, visitorToken, type])
}

model Summary {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  locale      String
  text        String
  topics      String   @default("[]") // JSON: TopicJSON[] (see §6)
  suggestedQuestions String @default("[]")
  reviewCount Int      @default(0)
  model       String?
  updatedAt   DateTime @updatedAt

  @@unique([shop, productId, locale])
}

model TranslationCache {
  id        String   @id @default(cuid())
  reviewId  String
  target    String
  title     String?
  body      String?
  reply     String?
  createdAt DateTime @default(now())

  @@unique([reviewId, target])
}

model Setting {
  shop                 String  @id
  autoPublish          Boolean @default(false)
  brandDisplayName     String  @default("Cellexia")
  notifyEmail          String?
  aiProvider           String  @default("anthropic") // anthropic | off
  anthropicApiKey      String?
  aiModel              String  @default("claude-sonnet-5")
  translationProvider  String  @default("anthropic") // anthropic | deepl | google | off
  deeplApiKey          String?
  googleApiKey         String?
  showTranslate        Boolean @default(true)
  showQna              Boolean @default(false)
  showSummary          Boolean @default(true)
  showMediaStrip       Boolean @default(true)
  emitJsonLd           Boolean @default(true)
  reviewsPerPage       Int     @default(10)
  summaryAutoThreshold Int     @default(5) // regenerate after N new published reviews
  designTheme          String  @default("amazon") // amazon | cellexia
  isLive               Boolean @default(false) // storefront visibility gate; new installs start NOT live
  previewToken         String? // tokenized live-theme preview; lazily generated in getSettings
  proxySubpath         String  @default("cellexia-reviews")
  lastStorefrontHitAt  DateTime?
  lastSyncError        String?
  lastSyncAt           DateTime?
  rankingStrategy      String  @default("amazon_top")
  rankingBoosts        String  @default("{}")
  translationDisplay   String  @default("original")
  overallWidget        String  @default("{}")
  liveScope            String  @default("all")
  liveMarkets          String  @default("[]")
  hideStamped          Boolean @default(false)
  stampedSelectors     String?
  observedMarkets      String  @default("{}")
  curationInstructions String?
  curationOverviewField String @default("accentuate.overview")
  curationSource       String  @default("as_seen")
  curationRefresh      String  @default("manual")
  brandPageConfig      String  @default("{}")
  curationBudgetUsd    Float?
  curationSpendMonth   String  @default("")
  curationBatchLock    DateTime?
  curationSpendUsd     Float   @default(0)
}

model CurationBatch {
  id               String    @id @default(cuid())
  shop             String
  anthropicBatchId String    @unique
  status           String    @default("in_progress")
  model            String
  requestCount     Int
  succeeded        Int       @default(0)
  errored          Int       @default(0)
  expired          Int       @default(0)
  pairs            String
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  costUsd          Float     @default(0)
  reservedUsd      Float     @default(0)
  reservedMonth    String    @default("")
  error            String?
  submittedAt      DateTime  @default(now())
  endedAt          DateTime?
  claimedAt        DateTime?
  appliedAt        DateTime?

  @@index([shop, status])
}

model BrandAnalysis {
  shop        String    @id
  sections    String
  reviewCount Int
  dateFrom    DateTime?
  dateTo      DateTime?
  model       String?
  generatedAt DateTime  @updatedAt
}

model AskAnswer {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  locale       String
  questionHash String
  question     String
  answer       String
  quotes       String   @default("[]")
  createdAt    DateTime @default(now())

  @@unique([shop, productId, locale, questionHash])
  @@index([shop, productId])
}

model AiCuration {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  locale      String
  orderedIds  String   @default("[]")
  rationale   String   @default("")
  model       String?
  reviewCount Int      @default(0)
  sourceCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, productId, locale])
  @@index([shop, productId])
}

model ProductDisplayConfig {
  id        String   @id @default(cuid())
  shop      String
  productId String
  strategy  String?
  pinnedIds String   @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([shop, productId])
}

model GenerationJob {
  id             String    @id @default(cuid())
  shop           String
  status         String    @default("QUEUED")
  productId      String
  productTitle   String?
  batchId        String
  config         String
  target         Int
  created        Int       @default(0)
  failed         Int       @default(0)
  chunksTotal    Int       @default(0)
  chunksDone     Int       @default(0)
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  costUsd        Float     @default(0)
  // v1.24 skeptic pass: rows judged and rows removed by the double-check.
  checkedCount   Int       @default(0)
  removedByCheck Int       @default(0)
  estimate       String?
  error          String?
  errors         String    @default("[]")
  publishAt      DateTime?
  publishedAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  heartbeatAt    DateTime?
  cancelRequested Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, createdAt])
}

model ModelThroughput {
  id             String   @id @default(cuid())
  shop           String
  model          String
  chunkCount     Int      @default(0)
  totalSeconds   Float    @default(0)
  totalReviews   Int      @default(0)
  totalInTokens  Int      @default(0)
  totalOutTokens Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([shop, model])
}
