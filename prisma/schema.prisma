generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Review {
  id           String        @id @default(cuid())
  shop         String
  productId    String        // numeric Shopify product id as string, e.g. "8654321098765"
  productTitle String?
  productHandle String?
  rating       Int           // 1..5
  title        String?
  body         String
  language     String        @default("en") // ISO 639-1 (+region for pt-PT)
  authorName   String
  authorEmail  String?
  customerId   String?
  country      String?       // ISO 3166-1 alpha-2, optional
  variantTitle String?
  verified     Boolean       @default(false)
  status       String        @default("PENDING") // PENDING | PUBLISHED | REJECTED | SPAM
  ageRange     String?       // AGE_RANGES key
  skinConcerns String        @default("[]") // JSON array of SKIN_CONCERNS keys
  timeUsing    String?       // TIME_USING key
  resultsSeen  String        @default("[]") // JSON array of RESULTS_SEEN keys
  helpfulCount Int           @default(0)
  reportCount  Int           @default(0)
  reply        String?
  replyAt      DateTime?
  ipHash       String?
  isSynthetic  Boolean       @default(false) // v1.4 QA generator flag — admin-only, never serialized to the storefront
  qaChecked    Boolean       @default(false) // v1.24: this synthetic row survived (or predates) the skeptic pass
  source       String?       // "storefront" | "csv-import" | "bulk-add" | "synthetic" (null = pre-1.4 rows)
  syntheticBatchId     String?   // groups one QA-generator run; null for non-synthetic rows
  syntheticGeneratedAt DateTime? // when the QA generator created the row (createdAt holds the backdated review date)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  media        ReviewMedia[]
  votes        Vote[]

  @@index([shop, productId, status])
  @@index([shop, status])
  @@index([shop, createdAt])
  @@index([shop, isSynthetic])
}

model ReviewMedia {
  id        String  @id @default(cuid())
  review    Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId  String
  type      String  // IMAGE | VIDEO
  fileGid   String? // Shopify File GID
  url       String? // resolved CDN URL (nullable until Shopify finishes processing)
  thumbUrl  String?
  position  Int     @default(0)

  @@index([reviewId])
}

model Vote {
  id           String   @id @default(cuid())
  review       Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId     String
  visitorToken String
  type         String   // HELPFUL | REPORT
  reason       String?  // REPORT_REASONS key
  createdAt    DateTime @default(now())

  @@unique([reviewId, visitorToken, type])
}

model Summary {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  locale      String
  text        String
  topics      String   @default("[]") // JSON: TopicJSON[] (see §6)
  // v1.16 (SPEC-1.16 §3): 4-5 shopper questions answerable from the reviews,
  // generated with the summary, localized with it. JSON string[].
  suggestedQuestions String @default("[]")
  reviewCount Int      @default(0)
  model       String?
  updatedAt   DateTime @updatedAt

  @@unique([shop, productId, locale])
}

model TranslationCache {
  id        String   @id @default(cuid())
  reviewId  String
  target    String
  title     String?
  body      String?
  reply     String?
  createdAt DateTime @default(now())

  @@unique([reviewId, target])
}

model Setting {
  shop                 String  @id
  autoPublish          Boolean @default(false)
  brandDisplayName     String  @default("Cellexia")
  notifyEmail          String?
  aiProvider           String  @default("anthropic") // anthropic | off
  anthropicApiKey      String?
  aiModel              String  @default("claude-sonnet-5")
  translationProvider  String  @default("anthropic") // anthropic | deepl | google | off
  deeplApiKey          String?
  googleApiKey         String?
  showTranslate        Boolean @default(true)
  // v1.16 (SPEC-1.16 §3): the review Q&A box. Opt-in — shopper questions
  // spend API tokens, so the merchant switches it on deliberately.
  showQna              Boolean @default(false)
  showSummary          Boolean @default(true)
  showMediaStrip       Boolean @default(true)
  emitJsonLd           Boolean @default(true)
  reviewsPerPage       Int     @default(10)
  summaryAutoThreshold Int     @default(5) // regenerate after N new published reviews
  designTheme          String  @default("amazon") // amazon | cellexia
  isLive               Boolean @default(false) // storefront visibility gate; new installs start NOT live
  previewToken         String? // tokenized live-theme preview; lazily generated in getSettings
  // v1.6 (SPEC-1.6 §2): the app-proxy subpath this install actually serves —
  // single source of truth for the storefront path. Detected by
  // probeProxySubpath (afterAuth + the storefront health check) and mirrored
  // onto the `cellexia.proxy_path` shop metafield that cx-proxy.liquid reads.
  proxySubpath         String  @default("cellexia-reviews")
  // Last app-proxy request that passed HMAC verification (any storefront
  // route). Powers the "is the theme extension enabled?" health check; null
  // means no storefront request has ever arrived. Written at most once per
  // 60 s per shop (recordStorefrontHit in proxy.server.ts).
  lastStorefrontHitAt  DateTime?
  // v1.6.1 (SPEC-1.6.1 §A): outcome of the most recent product metafield sync.
  // Until v1.6.1 every metafieldsSet failure (userErrors, missing scope,
  // throttling, definition/type conflicts) went into a console.error the
  // merchant never saw, so a store could sit with stale metafields — no SSR
  // stars, no rich snippets, no title badge — with nothing in the admin saying
  // so. `lastSyncError` holds the compact reason for the last FAILED sync
  // (first userError as "field: message (code)", or the thrown message, max
  // 500 chars) and is cleared the moment a sync succeeds; `lastSyncAt` is when
  // that attempt ran, success or failure. Written by recomputeProduct
  // (aggregates.server.ts), surfaced verbatim by health check 5 and by the
  // token-gated `diag` block of /api/ping.
  lastSyncError        String?
  lastSyncAt           DateTime?
  // v1.8 (SPEC-1.8 §1/§2): shop-wide default review display order. The
  // defaults reproduce the pre-1.8 behavior exactly (amazon_top ordering, no
  // boosts, original-language display), so upgrades are shopper-invisible.
  // "rankingStrategy" is a RANKING_STRATEGIES key; "rankingBoosts" is a JSON
  // object { boostVerified?: boolean, boostMedia?: boolean } whose true flags
  // prepend orderBy keys (skipped for the "balanced" strategy);
  // "translationDisplay" is a TRANSLATION_DISPLAYS key ("original" |
  // "translated").
  rankingStrategy      String  @default("amazon_top")
  rankingBoosts        String  @default("{}")
  translationDisplay   String  @default("original")
  // v1.9 (SPEC-1.9 §1): configuration of the brand-wide "Overall reviews"
  // theme block. JSON: { mode?: "auto"|"picked", pickedIds?: string[] } —
  // parsed tolerantly on read (brand.server.ts parseOverallWidget): malformed
  // JSON or an unknown mode degrades to the auto ranking, and stale/
  // unpublished picked ids are dropped at use time, never persisted back.
  overallWidget        String  @default("{}")
  // v1.14 (SPEC-1.14): market-scoped go-live + Stamped takeover.
  // liveScope "all" reproduces pre-1.14 behavior exactly; "markets" limits
  // storefront visibility to the market handles in liveMarkets (JSON array).
  // isLive stays the master switch — false means live nowhere.
  liveScope            String  @default("all") // all | markets
  liveMarkets          String  @default("[]") // JSON string[] of market handles
  // Hide the incumbent Stamped reviews via CSS — ONLY inside markets where
  // this app is live (the style tag is emitted by the Liquid live-market
  // branch, so it structurally cannot fire elsewhere).
  hideStamped          Boolean @default(false)
  // Newline-separated CSS selector override; null = shipped defaults
  // (measured from cellexialabs.com, SPEC-1.14 §4). Sanitized on save.
  stampedSelectors     String?
  // Market handles the storefront has actually reported (via the widget's
  // market param) — {handle: isoTimestamp}. Lets the merchant pick markets
  // with zero extra API scopes: the recorded handle is exactly what Liquid
  // compares at render time.
  observedMarkets      String  @default("{}")
  // v1.17 (SPEC-1.17): AI Curator settings — merchant guidance appended to
  // every curation agent prompt, and the Accentuate "overview" metafield
  // reference (namespace.key) read as curation input.
  curationInstructions String?
  curationOverviewField String @default("accentuate.overview")
  // v1.18 (SPEC-1.18): what curation agents read — "as_seen" (what that
  // language's shoppers see) | "all_translated" (every review translated
  // into the agent's language at curation time, cached forever).
  curationSource       String  @default("as_seen")
  // v1.18 (SPEC-1.18): automatic re-curation of STALE existing curations —
  // "manual" | "daily" | "weekly". First-time curation is always manual.
  curationRefresh      String  @default("manual")
  // v1.19 (SPEC-1.19): brand reviews page feature toggles (JSON:
  // {ask?: bool, recommend?: bool} — both default true when absent).
  brandPageConfig      String  @default("{}")
  // v1.20 (SPEC-1.20 §3): optional spend ceiling for AI curation, in USD.
  // null = no ceiling (the preview still shows the cost before every run).
  curationBudgetUsd    Float?
  // Rolling monthly spend counter — "YYYY-MM" plus the USD total billed in
  // that month. Reset happens implicitly when the month string changes.
  curationSpendMonth   String  @default("")
  /**
   * Held while a background run is being assembled and submitted. Taken with
   * a compare-and-set, so two clicks cannot both get past the "one run at a
   * time" guard and bill the same work twice. Expires on its own so a crash
   * mid-submit does not lock the shop out.
   */
  curationBatchLock    DateTime?
  curationSpendUsd     Float   @default(0)
}

// v1.20 (SPEC-1.20 §4): one submitted Anthropic Message Batch of curation
// requests. `pairs` maps custom_id -> {productId, locale} so results can be
// applied back to the right curation; token/cost columns are filled from the
// batch's own usage once it ends.
model CurationBatch {
  id               String    @id @default(cuid())
  shop             String
  anthropicBatchId String    @unique
  status           String    @default("in_progress") // in_progress | canceling | ended | failed
  model            String
  requestCount     Int
  succeeded        Int       @default(0)
  errored          Int       @default(0)
  expired          Int       @default(0)
  pairs            String    // JSON: { "<custom_id>": { productId, locale } }
  inputTokens      Int       @default(0)
  outputTokens     Int       @default(0)
  costUsd          Float     @default(0)
  // Estimated cost charged to the ledger at SUBMIT time so several batches
  // cannot each pass the ceiling check; reconciled to the real cost on apply.
  reservedUsd      Float     @default(0)
  /**
   * The spend month ("YYYY-MM") the reservation was charged to. Releasing it
   * must credit THAT month, never simply "now" — a July reservation released
   * in August would otherwise be subtracted from August's fresh total.
   */
  reservedMonth    String    @default("")
  error            String?
  submittedAt      DateTime  @default(now())
  endedAt          DateTime?
  /**
   * Set when a poll takes ownership of applying the results, cleared on
   * failure. Distinct from appliedAt (set only once the results are actually
   * stored) so a process that dies mid-apply leaves a claim that goes stale
   * and can be retried, instead of stranding results the merchant paid for.
   */
  claimedAt        DateTime?
  appliedAt        DateTime?

  @@index([shop, status])
}

// v1.19 (SPEC-1.19 §6): the AI-written analysis for the "Cellexia Reviews"
// brand page — one row per shop. Numbers are always computed
// deterministically at render time; `sections` holds the verified prose +
// verbatim quotes only.
model BrandAnalysis {
  shop        String    @id
  sections    String    // JSON (see brand-page.server.ts AnalysisSections)
  reviewCount Int
  dateFrom    DateTime?
  dateTo      DateTime?
  model       String?
  generatedAt DateTime  @updatedAt
}

// v1.16 (SPEC-1.16 §3): cached Q&A answers — one row per distinct question
// per product+locale, so repeat questions (and every suggested-question tap
// after the first) cost zero model calls. quotes: JSON
// [{id, excerpt, author, rating}] hydrated at write time.
model AskAnswer {
  id           String   @id @default(cuid())
  shop         String
  productId    String
  locale       String
  questionHash String // sha256 of the normalized question
  question     String
  answer       String
  quotes       String   @default("[]")
  createdAt    DateTime @default(now())

  @@unique([shop, productId, locale, questionHash])
  @@index([shop, productId])
}

// v1.17 (SPEC-1.17 §3): one AI-curated review order per product per locale.
// orderedIds: JSON string[] (best first); rationale: the agent's explanation
// in that locale's language, shown verbatim in the admin. reviewCount is the
// candidate count at run time (staleness display).
model AiCuration {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  locale      String
  orderedIds  String   @default("[]")
  rationale   String   @default("")
  model       String?
  /** How many reviews the agent actually read (post-trim). */
  reviewCount Int      @default(0)
  /**
   * v1.20: how many reviews were PUBLISHED when the run happened. Staleness
   * compares against this, not reviewCount — otherwise a run that had to trim
   * its payload would read as stale the instant it finished, and the
   * auto-refresh sweep would re-bill the shop's largest product every window
   * forever. 0 on rows written before 1.20.0, which fall back to reviewCount.
   */
  sourceCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, productId, locale])
  @@index([shop, productId])
}

// v1.8 (SPEC-1.8 §1): per-product review display override. At most one row
// per (shop, productId); the row is deleted when the merchant reverts to the
// shop default with no pinned reviews, so absence == "inherit everything".
model ProductDisplayConfig {
  id        String   @id @default(cuid())
  shop      String
  productId String
  // RANKING_STRATEGIES key, or null = inherit the shop default.
  strategy  String?
  // JSON string[] of review ids, in the exact order to show first.
  pinnedIds String   @default("[]")
  updatedAt DateTime @updatedAt

  @@unique([shop, productId])
}

// v1.7 (SPEC-1.7 §1): one background synthetic-generation job. The runner in
// app/services/jobs.server.ts claims QUEUED rows (oldest first, max 2 RUNNING
// per shop), drives chunked generation, and writes progress + a heartbeat
// after every chunk so a crashed run can be detected (heartbeatAt older than
// 3 minutes) and re-queued without ever overshooting `target` (existing rows
// for `batchId` are counted before resuming).
model GenerationJob {
  id             String    @id @default(cuid())
  shop           String
  status         String    @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED|CANCELLED
  productId      String
  productTitle   String?
  batchId        String    // the Review.syntheticBatchId this job writes
  config         String    // JSON: the full SyntheticConfig (SPEC-1.4 §C)
  target         Int       // reviews requested
  created        Int       @default(0)
  failed         Int       @default(0)
  chunksTotal    Int       @default(0) // chunks of the CURRENT run (recomputed when a job is claimed/resumed)
  chunksDone     Int       @default(0)
  inputTokens    Int       @default(0)  // actuals, summed across chunks
  outputTokens   Int       @default(0)
  costUsd        Float     @default(0)
  // v1.24 skeptic pass: rows judged and rows removed by the double-check.
  checkedCount   Int       @default(0)
  removedByCheck Int       @default(0)
  estimate       String?   // JSON: EstimateDTO produced before the run
  error          String?   // first fatal error (truncated 500 chars)
  errors         String    @default("[]") // JSON string[]: per-chunk failures, capped at 20
  startedAt      DateTime?
  finishedAt     DateTime?
  heartbeatAt    DateTime?
  cancelRequested Boolean  @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shop, status])
  @@index([shop, createdAt])
}

// v1.7 (SPEC-1.7 §1/§4): rolling per-shop+model calibration measured from real
// generation chunks. Powers the "measured" basis of cost/time estimates
// (estimate.server.ts) once chunkCount >= 3. Updated by the job runner after
// every successful chunk.
model ModelThroughput {
  id             String   @id @default(cuid())
  shop           String
  model          String
  chunkCount     Int      @default(0)   // chunks measured
  totalSeconds   Float    @default(0)
  totalReviews   Int      @default(0)
  totalInTokens  Int      @default(0)
  totalOutTokens Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([shop, model])
}
