{
  "name": "cellexia-reviews",
  "version": "1.29.1",
  "private": true,
  "description": "Amazon-grade product reviews for the Cellexia storefront — Shopify embedded app with theme app extension, AI summaries and 17 storefront languages.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.10 <21 || >=22 <23 || >=23.3"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "start": "remix-serve ./build/server/index.js",
    "setup": "prisma generate && prisma migrate deploy",
    "setup:production": "node scripts/check-datasource.mjs && prisma generate --schema=./prisma/schema.production.prisma && prisma db push --schema=./prisma/schema.production.prisma --skip-generate",
    "docker-start": "npm run setup:production && npm run start",
    "seed:demo": "node prisma/seed.js",
    "check:locales": "node scripts/check-locales.mjs",
    "selftest": "node scripts/selftest.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^13.9.0",
    "@shopify/shopify-app-remix": "^3.7.0",
    "@shopify/shopify-app-session-storage-prisma": "^6.0.0",
    "dotenv": "^16.6.1",
    "isbot": "^5.1.0",
    "papaparse": "^5.4.1",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^6.2.2",
    "vite-tsconfig-paths": "^5.0.1"
  },
  "devDependencies": {
    "@shopify/cli": "^3.77.1",
    "@types/node": "^22.10.1",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "archiver": "^7.0.1",
    "typescript": "^5.7.2"
  }
}
